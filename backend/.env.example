# Copy this file to .env and fill it in. .env is ignored by git.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Optional: lets the general chat manager write replies (https://console.anthropic.com → API keys)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: live TikTok Shop data from Cruva (https://cruva.com/dashboard/api). Without a key
# the dashboard shows sample data. The key is server-wide, so only the workspaces whose owner
# email is listed below get live data; every other sign-up keeps seeing sample data.
# CRUVA_API_KEY=
# CRUVA_SHOP_ID=          (optional: the shop shown first; cruva.com/dashboard/my-shops → View Info)
# CRUVA_ALLOWED_EMAILS=you@example.com,partner@example.com

# Optional: "Continue with Google". Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this Authorized redirect URI:
#   http://localhost:5173/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional
# PORT=8787
# DATABASE_FILE=./data/kreo.db
