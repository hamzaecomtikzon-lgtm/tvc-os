# Copy this file to .env and fill it in. .env is ignored by git.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Optional: lets the general chat manager write replies (https://console.anthropic.com → API keys)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: "Continue with Google". Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this Authorized redirect URI:
#   http://localhost:5173/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional
# PORT=8787
# DATABASE_FILE=./data/kreo.db
