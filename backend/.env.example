# Copy this file to .env and fill it in. .env is ignored by git.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Optional: lets the general chat manager write replies (https://console.anthropic.com → API keys)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Encrypts each workspace's CRM API key in the database. Set it in production to a long random
# string (e.g. `openssl rand -base64 32`) and never change it: saved keys can't be read after a
# change, and those customers have to paste their key again. Without it, a secret is generated
# into data/.kreo-secret (fine locally, not in production: it sits next to the database).
# KREO_SECRET_KEY=

# Live TikTok Shop data from Cruva (https://cruva.com/dashboard/api). Each customer connects
# their own Cruva key in setup step 3 or Settings → CRM. Optionally, a server-wide key below
# also gives live data to the workspaces whose owner email is listed (used when a workspace
# has no key of its own). Workspaces with neither see sample data.
# CRUVA_API_KEY=
# CRUVA_SHOP_ID=          (optional: the shop shown first; cruva.com/dashboard/my-shops → View Info)
# CRUVA_ALLOWED_EMAILS=you@example.com,partner@example.com

# Optional: "Continue with Google". Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this Authorized redirect URI:
#   http://localhost:5173/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional
# PORT=8787
# DATABASE_FILE=./data/kreo.db
